# Copy to .env.local for local overrides. On Vercel, set these under
# Project → Settings → Environment Variables.

# Postgres connection. Vercel's Neon integration sets this for you.
# Leave unset locally to use the JSON file in data/nichedesk.json.
DATABASE_URL=

# Password for the tool (/app) and its editing APIs. Unset = no lock.
# Set it on any public deployment.
APP_PASSWORD=

# Secret for creating and managing extension license keys (16+ characters).
# Unset = license management is closed.
NICHEDESK_ADMIN_TOKEN=

# Public address, for canonical URLs, the sitemap and share images.
# Optional on Vercel (the production URL is picked up automatically) until
# you add a custom domain.
NEXT_PUBLIC_SITE_URL=
