{
  "manifest_version": 3,
  "name": "NicheDesk Research",
  "short_name": "NicheDesk",
  "version": "1.0.0",
  "description": "Etsy niche research for eRank users: filter keywords, see who holds the top listings, and get a GO / NO-GO report.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NicheDesk Research",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://members.erank.com/*",
    "https://openapi.etsy.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "minimum_chrome_version": "116"
}
